# URL del proyecto en Supabase (ejemplo: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Llave anónima pública de Supabase (anon public key)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Correos de Google autorizados para acceder a la aplicación (separados por coma)
# Ejemplo: user_one@mail.com,user_two@mail.com
VITE_ALLOWED_EMAILS=
